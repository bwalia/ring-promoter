# Fastfile — Ring Promoter native iOS release (GitHub Actions + Vault + fastlane).
#
# CI signs with an App Store Connect API key pulled from Vault by
# ci/load-ios-vault-secrets.sh. Ported from the KubePilot pipeline
# (kubepilot/ios/fastlane/Fastfile); the differences are that this project has
# a committed .xcodeproj (no xcodegen) and a widget that uses an app group.
# See .github/workflows/ios-release.yml.

default_platform(:ios)

APP_ID = "org.fictionally.ringpromoter".freeze
WIDGET_APP_ID = "org.fictionally.ringpromoter.widget".freeze
APP_GROUP_ID = "group.org.fictionally.ringpromoter".freeze

# Publisher branding, read from the environment so this repository can be
# released under a different company without a code change. These are the same
# values the web legal pages are built from — see web/.env.example — because a
# privacy policy and an App Store listing that name different publishers is
# exactly the kind of mismatch App Review notices.
#
# Nothing here is secret: all of it ends up on the public listing or the public
# legal pages, so in CI these belong in repository variables, not secrets.
def required_env(name)
  value = ENV[name].to_s.strip
  return value unless value.empty?

  UI.user_error!(
    "#{name} is not set. Store metadata is built from the environment so the " \
    "app can be released under another publisher without a code change. See " \
    "web/.env.example for the full list."
  )
end

def optional_env(name, fallback)
  value = ENV[name].to_s.strip
  value.empty? ? fallback : value
end

def branding
  @branding ||= begin
    publisher = required_env("PUBLISHER")
    {
      publisher: publisher,
      # Year of this build; override COPYRIGHT to pin a first-publication year.
      copyright: optional_env("COPYRIGHT", "#{Time.now.year} #{publisher}"),
      review: {
        first_name: required_env("REVIEW_FIRST_NAME"),
        last_name: required_env("REVIEW_LAST_NAME"),
        phone_number: required_env("REVIEW_PHONE"),
        # Defaults to the address the legal pages publish, which is normally
        # the one a reviewer should write to anyway.
        email_address: optional_env("REVIEW_EMAIL", required_env("CONTACT_EMAIL")),
        # No account exists, so "sign-in required" is No and these stay empty.
        demo_user: "",
        demo_password: "",
        notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__))
      }
    }
  end
end

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to Vault secret/ring-promoter/ios")
  end
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    in_house: false
  )
end

# Enable a capability on an App ID via the ASC API key session that
# `app_store_connect_api_key` already configured. A capability that is missing
# here means `sigh` will mint a profile without the matching entitlement, and
# the IPA then either fails to export or misbehaves at runtime — so this is a
# hard precondition, checked before the 15-minute build rather than after it.
#
# It reads, and deliberately does not write. Turning a capability ON through
# the API is not possible with an App Store Connect API key: spaceship's
# `patch_bundle_id_capability` puts `provisioning_request_client.team_id` in
# the request body, and `Spaceship::Client#team_id` resolves that by calling
# the legacy `/olympus/v1/session` endpoint, which only a username/password
# Apple ID session can authenticate. With a key it answers "Unauthenticated"
# and fastlane dies parsing that as JSON. (`team_id=` is no escape — it calls
# the same endpoint to validate.) Reaching it would mean writing into a
# private ivar of the gem, to automate a click that happens once per App ID
# in its entire lifetime. Not worth it; ticking the box is the fix.
def require_capability!(identifier, capability, label)
  require "spaceship"

  bundle = Spaceship::ConnectAPI::BundleId.find(
    identifier, includes: "bundleIdCapabilities"
  )
  UI.user_error!(
    "Bundle ID '#{identifier}' not found on the Developer Portal — create it first"
  ) unless bundle

  caps = bundle.bundle_id_capabilities || bundle.get_capabilities || []
  if caps.any? { |c| c.is_type?(capability) }
    UI.message("#{label} is enabled for #{identifier}")
    return
  end

  UI.user_error!(
    "#{label} is not enabled for the App ID '#{identifier}'.\n" \
    "\n" \
    "Enable it once, by hand, with an account that has Developer Portal " \
    "access (Account Holder or an Admin with Certificates, Identifiers & " \
    "Profiles):\n" \
    "\n" \
    "  1. https://developer.apple.com/account/resources/identifiers/list/bundleId\n" \
    "  2. Open '#{identifier}'\n" \
    "  3. Tick '#{label}', then Save\n" \
    "\n" \
    "Then re-run this workflow. An App Store Connect API key cannot do this " \
    "step — see the comment above require_capability! for why."
  )
end

# App Groups on both App IDs — the app writes the widget snapshot, the widget
# reads it. Specific group assignment still has to exist on the Developer Portal
# (create `group.org.fictionally.ringpromoter` and tick it on both identifiers
# once); this only enables the capability.
def ensure_app_groups!
  require "spaceship"

  [APP_ID, WIDGET_APP_ID].each do |identifier|
    require_capability!(
      identifier,
      Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS,
      "App Groups"
    )
  end

  UI.message(
    "Profiles regenerated below must include #{APP_GROUP_ID}. If codesign " \
    "rejects the entitlement, assign that group to both App IDs under " \
    "Certificates, Identifiers & Profiles → Identifiers → App Groups."
  )
end

# Push Notifications on the app App ID only — the widget does not register for
# APNs and must not claim an entitlement it never uses.
#
# Config/RingPromoter.entitlements declares aps-environment, so the App Store
# profile has to carry it or `codesign` rejects the export. Enabling the
# capability is also what stops registerForRemoteNotifications() failing with
# "no valid aps-environment entitlement string found" on a real device — the
# failure a reviewer would otherwise see printed in Settings.
def ensure_push!
  require "spaceship"

  require_capability!(
    APP_ID,
    Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS,
    "Push Notifications"
  )
end

# Fail fast when a freshly downloaded profile is missing the App Group the
# entitlements files claim — otherwise the IPA uploads and then crashes or
# fails install on device.
def assert_profile_entitlements!(profile_path, label, require_push: false)
  require "shellwords"
  UI.user_error!("Missing provisioning profile path for #{label}") if profile_path.to_s.empty?
  xml = `security cms -D -i #{Shellwords.escape(profile_path)} 2>/dev/null`
  UI.user_error!("Could not decode provisioning profile at #{profile_path}") if xml.empty?
  unless xml.include?(APP_GROUP_ID)
    UI.user_error!(
      "#{label} profile at #{profile_path} does not include #{APP_GROUP_ID}. " \
      "In the Developer Portal, enable App Groups on the App ID and assign " \
      "#{APP_GROUP_ID}, then re-run prepare_signing."
    )
  end
  UI.success("#{label} profile includes #{APP_GROUP_ID}")

  # Only the app declares aps-environment; the widget never registers for APNs.
  if require_push
    unless xml.include?("aps-environment")
      UI.user_error!(
        "#{label} profile at #{profile_path} carries no aps-environment " \
        "entitlement, but Config/RingPromoter.entitlements declares one. " \
        "Enable Push Notifications on #{APP_ID} in the Developer Portal, " \
        "then re-run prepare_signing."
      )
    end
    UI.success("#{label} profile includes aps-environment")
  end
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

# Deterministic IPA location, anchored to this file rather than Dir.pwd, so the
# build lane and the upload lanes (separate fastlane processes with different
# working directories) always agree on the path.
def ipa_output_dir
  File.expand_path("../build", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, "RingPromoter.ipa")
end

def write_export_options(path, app_profile, widget_profile)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>compileBitcode</key>
    \t<false/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{app_profile}</string>
    \t\t<key>#{WIDGET_APP_ID}</key>
    \t\t<string>#{widget_profile}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

platform :ios do
  desc "Run unit tests on the simulator"
  lane :test do
    run_tests(
      project: "RingPromoter.xcodeproj",
      scheme: "RingPromoter",
      devices: ["iPhone 17"],
      clean: true
    )
  end

  desc "Print next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into a persistent keychain"
  lane :prepare_signing do
    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    # The keychain persists across runs on the self-hosted runner so `cert` reuses
    # the same Apple Distribution certificate instead of minting a new one every
    # build (Apple caps distribution certs). Create it on first use, unlock after.
    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(
        path: kc_path,
        password: kc_pass,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        add_to_search_list: true
      )
    end
    # Keep the keychain on the codesign search list regardless of which branch ran.
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    # Disable the auto-lock timeout so the keychain stays unlocked between the
    # prepare_signing and build_ipa steps (separate fastlane processes).
    sh("security", "set-keychain-settings", kc_path)

    # Create (first run) or reuse (later runs) the distribution certificate from
    # the ASC API key. No certificate private key is stored in Vault.
    cert(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: kc_pass,
      output_path: tmp_dir
    )

    # Capabilities first, then force-regenerate profiles so they pick up both
    # the app group and aps-environment.
    ensure_app_groups!
    ensure_push!

    # `force` regenerates profiles; it conflicts with `readonly` — use force alone.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, force: true)
    app_profile_name = lane_context[SharedValues::SIGH_NAME]
    app_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    assert_profile_entitlements!(app_profile_path, "App", require_push: true)
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{app_profile_path}") if app_profile_path

    get_provisioning_profile(api_key: api_key, app_identifier: WIDGET_APP_ID, force: true)
    widget_profile_name = lane_context[SharedValues::SIGH_NAME]
    widget_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    assert_profile_entitlements!(widget_profile_path, "Widget")
    emit_github("GITHUB_ENV", "INSTALLED_WIDGET_PROFILE_PATH=#{widget_profile_path}") if widget_profile_path

    [
      ["RingPromoter", app_profile_name, APP_ID],
      ["RingPromoterWidgetExtension", widget_profile_name, WIDGET_APP_ID]
    ].each do |target, profile_name, bundle_id|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "RingPromoter.xcodeproj",
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        bundle_identifier: bundle_id,
        targets: [target]
      )
    end

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, app_profile_name, widget_profile_name)
    UI.success("Signing ready — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
      increment_version_number(
        version_number: ENV["VERSION_NAME"],
        xcodeproj: "RingPromoter.xcodeproj"
      )
    end
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER"),
      xcodeproj: "RingPromoter.xcodeproj"
    )

    export_plist = ENV.fetch("EXPORT_OPTIONS_PLIST")
    build_app(
      project: "RingPromoter.xcodeproj",
      scheme: "RingPromoter",
      export_method: "app-store",
      export_options: export_plist,
      output_directory: ipa_output_dir,
      output_name: "RingPromoter.ipa",
      clean: true
    )
  end

  desc "Upload the built IPA to TestFlight (internal testers only)"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
  end

  desc "Check everything App Review will look at, without building"
  lane :verify do
    # Scripted rather than listed in a checklist: the failure modes it catches
    # (a missing privacy manifest, an unaccepted screenshot size, a placeholder
    # left in the privacy policy) all cost a round trip with App Review.
    sh("./scripts/verify-app-store-readiness.sh")
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    # Fail before anything is uploaded, not after a reviewer finds it.
    verify

    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path

    # Waits, deliberately. `deliver` below has to attach a build to the
    # version, and a build that is still processing cannot be attached — the
    # submission then fails after the upload has already happened, which is
    # the most annoying place to fail. Processing is usually 5-20 minutes and
    # the job allows 90.
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )

    # Metadata and screenshots now come from this repo (fastlane/metadata and
    # fastlane/screenshots), so the listing is reviewable in a pull request
    # instead of being retyped into App Store Connect each release. That is
    # also why skip_* flipped to false: whatever is committed here wins.
    #
    # METADATA_LOCALE must match the App Store Connect primary language. If
    # ASC says English (U.S.), rename fastlane/metadata/en-GB and
    # fastlane/screenshots/en-GB to en-US and set this to match, or deliver
    # fails with "locale not available".
    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      # Publisher-specific values come from the environment rather than from
      # committed .txt files, so a rebrand needs no edit here. notes.txt stays
      # a file because it is long prose worth reviewing in a diff.
      copyright: branding[:copyright],
      app_review_information: branding[:review],
      # No export_compliance_* keys here on purpose: ITSAppUsesNonExemptEncryption
      # in Config/RingPromoter-Info.plist already answers that question, App
      # Store Connect then stops asking it, and setting it again through the API
      # is at best redundant.
      submission_information: {
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end
end
