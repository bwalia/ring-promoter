    {
      "id": 10,
      "type": "gauge",
      "title": "CIS compliance score",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Checkov checks passed / ran. Gate: GO at 95% or more, NO-GO at 80% or less.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(rp_sec_compliance_score_percent{app=~\"$app\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      }
    },
