{
  "uid": "rp-security-compliance",
  "title": "Ring Promoter — Security & Compliance",
  "description": "Open-source AppSec, supply-chain and compliance evidence for the Ring Promoter training apps: gosec, Semgrep, govulncheck, gitleaks, Checkov (CIS), Syft SBOM, Grype, licence policy, SLSA provenance. Ring Promoter's Grafana gate reads these series for Go/No-Go.",
  "tags": [
    "ring-promoter",
    "security",
    "compliance",
    "sbom",
    "training"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "QA unit tests",
      "type": "link",
      "url": "/d/rp-qa-unit-tests?${app:queryparam}",
      "icon": "dashboard"
    },
    {
      "title": "Ring Promoter (training)",
      "type": "link",
      "url": "https://ring-promoter.fictionally.org/?app=hello-world",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(rp_sec_run_info, app)",
          "refId": "app"
        },
        "definition": "label_values(rp_sec_run_info, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "hello-world"
          ],
          "value": [
            "hello-world"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SAST",
      "description": "gosec + Semgrep. GO = no critical/high finding in the latest scan. NO DATA once the scan is older than 36h.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(rp_sec_scan_status{app=~\"$app\",kind=\"sast\"} and on(app,kind) (time() - rp_sec_scan_timestamp_seconds{app=~\"$app\",kind=\"sast\"} < 129600))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "GO",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "NO-GO",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
