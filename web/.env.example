# Branding for the published legal pages (/privacy, /terms, /support).
#
# These are read at BUILD time by Server Components and baked into the static
# export, so the same codebase can be published under a different company
# without a code change. Nothing here is secret — every value ends up visible
# on the published pages — so in CI they belong in repository *variables*,
# not secrets.
#
# Copy to .env.local for local work:  cp .env.example .env.local
#
# The first four have no defaults on purpose. A production build fails rather
# than publish a legal page that names the wrong publisher or gives a support
# address that bounces — Apple opens both URLs and emails the address during
# App Store review.

# Legal or trading name of the publisher, as it should appear on the pages.
PUBLISHER="Example Ltd"

# A mailbox that is genuinely monitored. Apple writes to it during review.
CONTACT_EMAIL="support@example.com"

# Governing law for the terms.
JURISDICTION="England and Wales"

# Postal address, one line per `|`-separated segment. Required by clause 8 of
# Apple's Minimum Terms for a developer-supplied EULA, and by the App Store's
# EU trader details under the Digital Services Act.
POSTAL_ADDRESS="1 Example Street|London|EC1A 1AA"

# ─────────────────────────────────────────────────────────────────────────────
# Optional. These default to this project's own identity, so an ordinary build
# needs none of them. Set them for a white-label launch.

# APP_NAME="Ring Promoter"
# BUNDLE_ID="org.fictionally.ringpromoter"
# GITHUB_URL="https://github.com/bwalia/ring-promoter"
# SITE_URL="https://ring-promoter-pages.fictionally.org"

# Shown as "last updated" on every legal page. Override only when a rebrand
# also changes the wording — bumping it for unchanged text misleads readers.
# LEGAL_LAST_UPDATED="6 November 2026"
